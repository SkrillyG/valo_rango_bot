# ============================================================
# Variables del bot (copia este archivo a .env y rellenalo)
# NUNCA subas el archivo .env real a git
# ============================================================

# ---------- Base de datos (obligatoria) ----------
# Postgres. En Render: crealo en "Postgres" y copiala aqui.
# Local: postgresql://usuario:clave@localhost:5432/valo_rango
DATABASE_URL=
# Si el proveedor exige SSL (Neon, Supabase, algunos planes de Render): true
# DATABASE_SSL=false

# ---------- Cifrado de datos (obligatoria) ----------
# Clave para cifrar las API keys de los streamers (AES-256-GCM).
# Minimo 16 caracteres. Genera una con: openssl rand -base64 32
# Si la cambias, las keys ya guardadas dejan de descifrarse.
ENCRYPTION_KEY=

# ---------- Sesiones / cookies (obligatoria) ----------
# Firma de la cookie de sesion (login de Twitch y formulario /setup).
# Minimo 16 caracteres. Genera una con: openssl rand -base64 32
SESSION_SECRET=

# ---------- OAuth de Twitch (obligatoria) ----------
# Creador de una aplicacion en https://dev.twitch.tv/console/apps
# OAuth Redirect URL: https://TU-DOMINIO/auth/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ---------- URL publico (recomendada) ----------
# Base publica del bot. Si no la defines, se deduce del Host de cada
# peticion (util en local). En produccion defínela siempre.
# BASE_URL=https://valo-rango.onrender.com

# ---------- Puerto ----------
# PORT=3000

# ---------- API de rango (HenrikDev) ----------
# Base del proveedor. Alternativa europea (sin Cloudflare, ~50ms):
# HENRIK_API_BASE=https://eu.api.henrikdev.xyz
# HENRIK_API_BASE=https://api.henrikdev.xyz

# ---------- Cache ----------
# Tiempo que se sirve el rango cacheado (ms) y ventana de cache obsoleta
# que se usa si el proveedor falla (ms).
# CACHE_TTL_MS=90000
# CACHE_STALE_MS=600000

# ---------- Timeouts ----------
# Timeout de cada llamada al proveedor (ms), reintentos y limite total
# de la peticion (ms). El limite total debe quedar por debajo del
# timeout de Nightbot (10 s) y StreamElements (15 s).
# UPSTREAM_TIMEOUT_MS=4000
# UPSTREAM_RETRIES=1
# REQUEST_DEADLINE_MS=8000

# ---------- Rate limit ----------
# Peticiones por token al endpoint /rank (por minuto).
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30
# Peticiones por IP a /setup y /auth (por minuto).
# RATE_LIMIT_SETUP_WINDOW_MS=60000
# RATE_LIMIT_SETUP_MAX=20

# ---------- Sesiones ----------
# Duracion maxima de la cookie de sesion (ms). Por defecto 30 dias.
# SESSION_MAX_AGE_MS=2592000000

# ---------- Entorno ----------
# NODE_ENV=production
