# API Key de HenrikDev (obligatoria desde la v4.0.0 de la API).
# Obtenela en https://api.henrikdev.xyz/dashboard/ -> API Keys -> Generate New Key
# Atajo sin registro: https://discord.com/invite/X3GaVkX2YN -> canal #get-a-key
# NUNCA subas esta key a git: este archivo esta en .gitignore
HENRIK_API_KEY=

# Base del API de HenrikDev.
# Alternativa europea (sin Cloudflare, ~50ms): https://eu.api.henrikdev.xyz
# HENRIK_API_BASE=https://api.henrikdev.xyz

# Region y plataforma del jugador
# HENRIK_REGION=eu
# HENRIK_PLATFORM=pc

# Riot ID del jugador
# VALORANT_NAME=macarrones
# VALORANT_TAG=pato

# Nombre que se muestra en el chat
# DISPLAY_NAME=Sofi

# Cache en memoria (ms) y timeouts
# CACHE_TTL_MS=60000
# UPSTREAM_TIMEOUT_MS=5000
# UPSTREAM_RETRIES=1
# REQUEST_DEADLINE_MS=12000
